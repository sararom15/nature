---
// Icone lineari decorative (ereditano il colore del testo).
const { name, class: className = 'icon' } = Astro.props;
---
<svg class={className} viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'phone' && <path d="M5 4h3l2 5-2.5 1.5a11 11 0 0 0 6 6L15 14l5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" />}
  {name === 'mail' && <Fragment><rect x="3" y="5" width="18" height="14" rx="1" /><path d="m3 7 9 6 9-6" /></Fragment>}
  {name === 'pin' && <Fragment><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></Fragment>}
  {name === 'route' && <path d="M3 11 21 3l-8 18-2-8-8-2z" />}
  {name === 'instagram' && <Fragment><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r=".6" fill="currentColor" /></Fragment>}
  {name === 'facebook' && <path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8z" />}
  {name === 'share' && <Fragment><circle cx="6" cy="12" r="2.5" /><circle cx="18" cy="6" r="2.5" /><circle cx="18" cy="18" r="2.5" /><path d="m8.2 10.8 7.6-3.6M8.2 13.2l7.6 3.6" /></Fragment>}
</svg>
