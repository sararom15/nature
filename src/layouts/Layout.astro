---
// Font della brochure, ospitati localmente: Lato per i testi, Bitter corsivo per i titoli.
import '@fontsource/lato/400.css';
import '@fontsource/lato/400-italic.css';
import '@fontsource/lato/700.css';
import '@fontsource/lato/700-italic.css';
import '@fontsource/lato/900.css';
import '@fontsource/bitter/700-italic.css';
import '@fontsource/bitter/800-italic.css';
import '../styles/style.css';
import '../styles/contacts.css';
import '../styles/brochure.css';
import ProductTemplates from '../components/ProductTemplates.astro';
import Icon from '../components/Icon.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { nav, titles, href, company, maps, social } from '../data/site.js';

/** path: chiave della pagina ('' = home). products: true se la pagina mostra la griglia dei formati. */
const { path = '', products = false } = Astro.props;
const year = new Date().getFullYear();

// Dati strutturati (schema.org) per i motori di ricerca: non visibili sulla pagina.
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: company.name,
  brand: { '@type': 'Brand', name: 'Nature' },
  vatID: `IT${company.vat}`,
  telephone: company.phoneHref.replace('tel:', ''),
  email: company.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: company.street,
    postalCode: company.zip,
    addressLocality: company.city,
    addressRegion: company.province,
    addressCountry: 'IT',
  },
  hasMap: maps.view,
  sameAs: social.map((s) => s.url).filter(Boolean),
};
---
<!doctype html>
<html lang="it"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#3da4b0"><title>{titles[path] ?? 'Nature'}</title><meta name="description" content="Nature: pasta artigianale dal grano coltivato dall’Azienda Agricola Romano a Poggio Imperiale, in Puglia. Cinque formati, trafilatura al bronzo e un’origine da conoscere.">
<script is:inline>
// Compatibilità con i vecchi indirizzi del sito (es. /#/pasta → /pasta/).
(function(){var m=location.hash.match(/^#\/([a-z]*)(\?.*)?$/);if(m)location.replace('/'+(m[1]?m[1]+'/':'')+(m[2]||''));})();
</script>
<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</head><body><a class="skip" href="#main">Vai al contenuto</a><div class="topline"><span class="topline-location">Daunia · Puglia</span><span class="topline-slogan">Tradizione che nutre il futuro</span></div><div class="header-shell"><header><svg class="brand-color-defs" width="0" height="0" aria-hidden="true" focusable="false"><defs><filter id="nature-header-ink" color-interpolation-filters="sRGB"><feComponentTransfer><feFuncR type="linear" slope="0.929412" intercept="0.070588"></feFuncR><feFuncG type="linear" slope="0.756863" intercept="0.243137"></feFuncG><feFuncB type="linear" slope="0.701961" intercept="0.298039"></feFuncB></feComponentTransfer></filter></defs></svg><a href="/" class="brand brand-horizontal" aria-label="Nature — Un gesto d’amore, home"><span class="brand-fragment brand-rocks" aria-hidden="true"><img src="/assets/nature-logo.png" alt="" width="335" height="342"></span><span class="brand-wordmark-lockup"><span class="brand-fragment brand-wordmark" aria-hidden="true"><img src="/assets/nature-logo.png" alt="" width="335" height="342"></span><span class="brand-registered" aria-label="Marchio registrato">®</span></span></a><button class="menu-toggle" aria-controls="main-navigation" aria-label="Apri menu" aria-expanded="false">Menu <span>☰</span></button><nav id="main-navigation" aria-label="Menu principale">{nav.map((item) => (<a href={href(item.path)} class:list={[item.className, { active: item.path === path }]} aria-current={item.path === path ? 'page' : undefined}>{item.label}</a>))}</nav></header></div><main id="main" tabindex="-1"><div class="page-enter"><slot /></div></main>
<footer><svg class="brand-color-defs" width="0" height="0" aria-hidden="true" focusable="false"><defs><filter id="nature-footer-ivory" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB"><feColorMatrix type="matrix" values="0 0 0 0 0.972549 0 0 0 0 0.960784 0 0 0 0 0.929412 -0.2126 -0.7152 -0.0722 0 1"></feColorMatrix><feComposite in2="SourceGraphic" operator="in"></feComposite></filter></defs></svg><div class="footer-top"><a class="brand" href="/"><img src="/assets/nature-logo.png" alt="Nature — Un gesto d’amore" width="335" height="342"><span class="brand-registered" aria-label="Marchio registrato">®</span></a><p>Il valore della terra.<br>Il piacere di ritrovarlo a tavola.</p></div>
  <div class="footer-grid">
    <div class="footer-col" role="navigation" aria-labelledby="footer-explore"><h2 class="footer-title" id="footer-explore">Esplora</h2><ul class="footer-list">
      <li><a href="/">Home</a></li>
      {nav.map((item) => <li><a href={href(item.path)}>{item.label.replace(' ↗', '')}</a></li>)}
    </ul></div>
    <div class="footer-col"><h2 class="footer-title">Contatti</h2><ul class="footer-list">
      <li><a href={company.phoneHref}><Icon name="phone" /><span><span class="visually-hidden">Cellulare: </span>{company.phone}</span></a></li>
      <li><a href={`mailto:${company.email}`}><Icon name="mail" /><span class="break"><span class="visually-hidden">Email: </span>{company.email}</span></a></li>
    </ul><a class="footer-cta" href={href('contatti')}>Scrivici dal modulo ↗</a></div>
    <div class="footer-col"><h2 class="footer-title">Dove siamo</h2><address class="footer-address"><a href={maps.view} target="_blank" rel="noopener noreferrer">{company.name}<br>{company.street}<br>{company.zip} {company.city} ({company.province})<span class="visually-hidden"> — apri in Google Maps (si apre in una nuova scheda)</span></a></address></div>
    <div class="footer-col"><h2 class="footer-title">Seguici</h2><SocialLinks /></div>
  </div>
  <div class="footer-bottom"><span>© {year} {company.name} · P.IVA {company.vat}<br>{company.street} · {company.zip} {company.city} ({company.province})</span></div></footer><dialog id="product-dialog" aria-labelledby="product-title"><button class="close-dialog" aria-label="Chiudi dettaglio">×</button><div id="product-content"></div></dialog>{products && <ProductTemplates />}<script>import '../scripts/site.js';</script><slot name="scripts" />
</body></html>
