---
import Layout from '../layouts/Layout.astro';
import Img from '../components/Img.astro';
import Orb from '../components/Orb.astro';
import Icon from '../components/Icon.astro';
import PageHead from '../components/PageHead.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { company, maps } from '../data/site.js';

const newTab = ' (si apre in una nuova scheda)';
const address = `${company.street}, ${company.zip} ${company.city} (${company.province})`;
// Le quattro proposte: ogni scheda apre il modulo con l'argomento già selezionato.
const topics = [
  { id: 'box', img: '0272.jpg', who: 'Per casa o per un regalo', title: 'Box degustazione', text: 'Tre proposte da 19,90 a 45,00 € (prezzi indicativi).', cta: 'Scegli la tua box' },
  { id: 'campionatura', img: 'calamarata-detail.jpg', who: 'Per chef e ristoratori', title: 'Campionatura professionale', text: 'Prova la pasta nella tua cucina, con i tuoi condimenti.', cta: 'Richiedi i campioni' },
  { id: 'negozio', img: 'pasta-table.jpg', who: 'Per botteghe ed enoteche', title: 'Il tuo negozio', text: 'Presentaci la tua attività: preferiamo conoscerci di persona.', cta: 'Presenta il tuo negozio' },
  { id: 'aziendali', img: 'caserecce-texture.jpg', who: 'Per aziende ed eventi', title: 'Box aziendali', text: 'Un regalo dal territorio, con una proposta su misura.', cta: 'Organizza un regalo' },
];
const steps = [
  { title: 'Ci scrivi', text: 'Scegli l’argomento e raccontaci che cosa ti interessa. Bastano pochi minuti.' },
  { title: 'Ti rispondiamo noi', text: 'Ti risponde direttamente l’Azienda Agricola Romano, la famiglia che coltiva il grano di Nature.' },
  { title: 'Decidiamo insieme', text: 'Composizione, prezzo, disponibilità e consegna vengono confermati prima di ogni acquisto. Scriverci non ti impegna.' },
];
---
<Layout path="contatti">
<PageHead eyebrow="Contatti" title="Ogni relazione parte<br><em>da una domanda.</em>" intro="Informazioni sulle box, richieste di campionatura o un primo contatto con la nostra azienda agricola." />

<section class="section split contact-why"><div><span class="eyebrow">Chi ti risponde</span><h2>Dietro Nature<br>c’è una famiglia <em>di agricoltori.</em></h2><p>Nature è la pasta dell’Azienda Agricola Romano. Nasce dal grano duro che la nostra famiglia coltiva da tre generazioni a Poggio Imperiale, nell’Alto Tavoliere: macinato a pietra, trafilato al bronzo, essiccato lentamente.</p><p>Quando ci scrivi non trovi un call center, ma le persone che seguono il grano dalla semina alla pasta.</p><ul class="why-facts"><li>Grano coltivato da noi</li><li>Macinato a pietra</li><li>Trafilato al bronzo</li><li>Cinque formati da 500 g</li></ul><div class="actions"><a class="button" href="#modulo">Scrivici subito</a><a class="text-link" href="/progetto/">Scopri il progetto</a></div></div><Orb variant="ring" name="alto-tavoliere-tramonto.jpg" alt="I campi dell’Alto Tavoliere al tramonto" loading="lazy" sizes="(max-width:760px) 92vw, 45vw" /></section>

<section class="section contact-topics"><div class="section-heading"><div><span class="eyebrow">Come possiamo aiutarti</span><h2>Quattro buoni motivi<br>per <em>scriverci.</em></h2></div><p>Scegli quello che ti somiglia: il modulo si apre con l’argomento già selezionato.</p></div><div class="topic-grid">{topics.map((t) => (<a class="topic-card" href={`/contatti/?interesse=${t.id}#modulo`} data-topic={t.id}><figure><Img name={t.img} alt="" loading="lazy" widths={[480, 800]} sizes="(max-width:760px) 92vw, (max-width:1050px) 45vw, 22vw" /></figure><span class="topic-who">{t.who}</span><h3>{t.title}</h3><p>{t.text}</p><span class="topic-cta">{t.cta}</span></a>))}</div></section>

<section class="section blue-section contact-steps"><span class="eyebrow">Come funziona</span><h2>Tre passi, <em>nessun impegno.</em></h2><ol class="steps">{steps.map((s, i) => (<li><span class="step-n" aria-hidden="true">{i + 1}</span><h3>{s.title}</h3><p>{s.text}</p></li>))}</ol><div class="actions"><a class="button light" href="#modulo">Inizia da qui</a><a class="text-link" href={company.phoneHref}>Preferisci parlarne? Chiama il {company.phone}</a></div></section>

<section id="modulo" class="section contact-grid contact-page-grid"><div class="contact-request"><div class="contact-intro"><h3 id="contact-request-heading">Come possiamo aiutarti?</h3><p class="muted">Scegli l’argomento e scrivi il tuo messaggio.</p></div><form id="contact-form" aria-labelledby="contact-request-heading" data-recipient={company.email}><div class="form-row"><label>Nome e cognome *<input name="nome" autocomplete="name" required></label><label>Email *<input name="email" type="email" autocomplete="email" required></label></div><label>Di cosa vuoi parlare?<select name="interesse" aria-controls="contact-topic-help business-fields"><option value="generali">Informazioni generali</option><option value="box">Box degustazione</option><option value="campionatura">Campionatura professionale</option><option value="negozio">Un piccolo negozio</option><option value="aziendali">Box aziendali</option></select></label><p class="contact-topic-help" id="contact-topic-help" role="status" aria-live="polite" hidden></p><div id="business-fields" hidden><fieldset class="request-fields" data-topic="campionatura" hidden disabled><legend>Dati dell’attività</legend><div class="form-row"><label>Nome dell’attività *<input name="camp_nome" type="text" required autocomplete="organization"></label><label>Tipo di attività *<select name="camp_tipo" required><option value="">Seleziona</option><option>Ristorante</option><option>Pizzeria</option><option>Hotel / Struttura ricettiva</option><option>Catering / Banqueting</option><option>Altra attività professionale</option></select></label></div><div class="form-row"><label>P.IVA *<input name="camp_piva" type="text" required></label><label>Ruolo del richiedente *<input name="camp_ruolo" type="text" required autocomplete="organization-title"></label></div><div class="form-row"><label>Città *<input name="camp_citta" type="text" required autocomplete="address-level2"></label><label>Provincia *<input name="camp_provincia" type="text" required autocomplete="address-level1"></label></div></fieldset><fieldset class="request-fields" data-topic="negozio" hidden disabled><legend>Dati del negozio</legend><div class="form-row"><label>Nome del negozio *<input name="shop_nome" type="text" required autocomplete="organization"></label><label>Tipo di negozio *<select name="shop_tipo" required><option value="">Seleziona</option><option>Bottega alimentare</option><option>Gastronomia</option><option>Enoteca</option><option>Negozio online</option><option>Altro</option></select></label></div><div class="form-row"><label>P.IVA *<input name="shop_piva" type="text" required></label><label>Ruolo del richiedente (facoltativo)<input name="shop_ruolo" type="text" autocomplete="organization-title"></label></div><div class="form-row"><label>Città *<input name="shop_citta" type="text" required autocomplete="address-level2"></label><label>Provincia *<input name="shop_provincia" type="text" required autocomplete="address-level1"></label></div></fieldset><fieldset class="request-fields" data-topic="aziendali" hidden disabled><legend>Dati della richiesta aziendale</legend><label>Nome dell’azienda *<input name="corp_nome" type="text" required autocomplete="organization"></label><label>Occasione o finalità *<input name="corp_occasione" type="text" required></label><div class="form-row"><label>Numero indicativo di box *<input name="corp_quantita" type="number" required min="1" step="1"></label><label>Data entro cui servono *<input name="corp_data" type="date" required></label></div><label>Località di consegna *<input name="corp_localita" type="text" required autocomplete="address-level2"></label></fieldset></div><label>Il tuo messaggio *<textarea name="messaggio" required></textarea></label><p class="email-warning" id="contact-delivery-note">Il modulo prepara un’email indirizzata a <strong>{company.email}</strong>: la rivedi e la invii dal tuo programma di posta. Nessun dato viene inviato dal sito.</p><button class="button" type="submit" aria-describedby="contact-delivery-note">Prepara la tua email </button><p class="note">La richiesta rimane nel tuo browser. Puoi rivederla prima di aprire il programma email.</p><div id="draft" hidden><label>La tua bozza<textarea id="draft-text" readonly rows="8"></textarea></label><div class="actions"><button class="button" type="button" id="copy-draft">Copia il testo</button><a class="text-link" id="open-mail" href="#">Apri programma email</a></div><p class="note">Se il programma email non si apre, copia il testo e invialo a {company.email}.</p></div><p class="form-status" role="status"></p></form></div>
<div class="contact-location"><span class="eyebrow">{company.name}</span><h3>Qui nasce Nature.</h3><p>Poggio Imperiale · Foggia · Puglia</p><figure class="territory-card contact-territory"><div class="territory-visual"><Img class="territory-photo" name="poggio-imperiale-contatti.png" alt="Il paesaggio agricolo e il centro abitato di Poggio Imperiale" width="1448" height="1086" loading="lazy" widths={[480, 800, 1200, 1448]} sizes="(max-width:1050px) 92vw, 50vw" /><img class="territory-map" src="/assets/poggio-imperiale-map.svg" alt="Mappa dell’Italia con il contorno della Puglia, la Daunia rappresentata orientativamente e un punto su Poggio Imperiale" width="300" height="380" loading="lazy"><div class="territory-caption"><strong>Poggio Imperiale</strong><small>DAUNIA · PUGLIA</small></div><a class="territory-hit" href={maps.view} target="_blank" rel="noopener noreferrer"><span class="map-pill"><Icon name="pin" />Apri la mappa</span><span class="visually-hidden">: {company.name}, {address}, in Google Maps{newTab}</span></a></div><figcaption class="map-attribution"><details class="map-credits"><summary>Crediti mappa</summary><p>Confini <a href="https://github.com/guglielmo/geojson-italy" target="_blank" rel="noopener noreferrer">ISTAT / geojson-italy</a>, <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">CC BY 4.0</a>. Geometrie semplificate. Daunia rappresentata in modo orientativo su base provincia di Foggia.</p></details></figcaption></figure>
  <div class="location-details">
    <address class="location-address"><strong>{company.name}</strong><br>{company.street}<br>{company.zip} {company.city} ({company.province})</address>
    <div class="location-actions"><a class="button" href={maps.directions} target="_blank" rel="noopener noreferrer"><span><Icon name="route" />Indicazioni stradali<span class="visually-hidden">{newTab}</span></span></a><a class="text-link" href={maps.view} target="_blank" rel="noopener noreferrer">Apri in Google Maps<span class="visually-hidden">{newTab}</span></a></div>
    <dl class="company-data"><dt>Ragione sociale</dt><dd>{company.name}</dd><dt>P.IVA</dt><dd>{company.vat}</dd><dt>Sede</dt><dd>{address}</dd><dt>Telefono</dt><dd><a href={company.phoneHref}>{company.phone}</a></dd><dt>Email</dt><dd><a class="break" href={`mailto:${company.email}`}>{company.email}</a></dd><dt>Seguici</dt><dd><SocialLinks /></dd></dl>
  </div>
</div></section>
<Fragment slot="scripts"><script>import '../scripts/contact-form.js';</script></Fragment>
</Layout>
